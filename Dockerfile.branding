FROM registry.librechat.ai/danny-avila/librechat-dev-api:latest

# Patch branding: LibreChat -> PindyChat in all JS bundles
RUN find /app/client/dist/assets -name '*.js' -exec sed -i 's/LibreChat/PindyChat/g' {} + && \
    find /app/client/dist/assets -name '*.js' -exec sed -i 's/librechat\.ai/chat.pindyyogurt.store/g' {} +

# Override index.html title
RUN sed -i 's|<title>LibreChat</title>|<title>PindyChat</title>|g' /app/client/dist/index.html && \
    sed -i 's|content="LibreChat|content="PindyChat|g' /app/client/dist/index.html

# Add "PindyChat" text below the logo on the login page
COPY patch-login-branding.js /tmp/patch-login-branding.js
RUN node /tmp/patch-login-branding.js && rm /tmp/patch-login-branding.js

# Rename patched JS file to a new hash so the Vite PWA service worker
# (which precaches assets cache-first with revision:null) misses its cache
# and fetches the patched content from the network.
COPY cache-bust.js /tmp/cache-bust.js
RUN node /tmp/cache-bust.js && rm /tmp/cache-bust.js

# Copy Pindy yogurt logo and Qwen icon over the defaults
COPY client/public/assets/logo.svg /app/client/dist/assets/logo.svg
COPY client/public/assets/qwen.svg /app/client/dist/assets/qwen.svg
COPY client/public/assets/favicon-16x16.png /app/client/dist/assets/favicon-16x16.png
COPY client/public/assets/favicon-32x32.png /app/client/dist/assets/favicon-32x32.png
COPY client/public/assets/apple-touch-icon-180x180.png /app/client/dist/assets/apple-touch-icon-180x180.png
